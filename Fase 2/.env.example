# Configuración de Base de Datos PostgreSQL / PostGIS
DB_USER=adoptify_user
DB_PASS=adoptify_password123
DB_NAME=adoptify_db
DB_HOST=db
DB_PORT=5432

# URL de conexión asíncrona para SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# BD compartida del equipo (Supabase): reemplaza la línea DATABASE_URL de arriba por la del
# "Session pooler" y activa SSL. La contraseña se pasa por interno, nunca en git.
# DATABASE_URL=postgresql+asyncpg://postgres.<ref-del-proyecto>:<contraseña>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
# DB_SSL=true
# Las pruebas (pytest) siempre usan el Postgres local de Docker (DB_*); para otra BD de pruebas:
# TEST_DATABASE_URL=

# Fotos compartidas en Supabase Storage (bucket privado "fotos": solo se ven con sesión). Sin la llave, se guardan en el disco.
# La llave es SECRETA (Project Settings -> API Keys -> Secret keys): solo en el .env del backend.
# SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
# SUPABASE_SERVICE_KEY=

# Configuración del Backend
ENVIRONMENT=development

# Clave para firmar los tokens JWT (cámbiala por una cadena larga y aleatoria)
SECRET_KEY=cambiar-esta-clave-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=60

# RUT cifrado (HU-E). Con la BD compartida son obligatorias y las mismas para todo el equipo.
# Cifrado: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Hash:    python -c "import secrets; print(secrets.token_urlsafe(32))"
# Respaldar fuera del repo: si se pierde RUT_ENCRYPTION_KEY, los RUT no se pueden recuperar.
# RUT_ENCRYPTION_KEY=
# RUT_HASH_KEY=
API_PORT=8000
