VITE_API_URL=http://localhost:8000/api/v1

# Google Maps (vista del adoptante). Crea la key en Google Cloud con "Maps JavaScript API" habilitada
# y restríngela a http://localhost:5173/* . Es pública en el navegador: protégela con esa restricción.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID para marcadores avanzados; DEMO_MAP_ID sirve en desarrollo
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
